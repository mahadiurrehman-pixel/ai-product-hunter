datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum Recommendation {
  STRONG_BUY
  BUY
  HOLD
  AVOID
  HIGH_RISK
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  passwordHash          String?           // Nullable for OAuth accounts
  googleId              String?           @unique
  name                  String?
  role                  Role              @default(USER)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  watchlist             WatchlistItem[]
  alerts                Alert[]
  searchHistory         SearchHistory[]

  @@map("users")
}

model WatchlistItem {
  id                    String            @id @default(uuid())
  userId                String
  ebayItemId            String
  ebayTitle             String
  ebayPrice             Decimal           @db.Decimal(12, 2)
  ebayMarketplace       String
  supplierProductId     String
  supplierTitle         String
  supplierCost          Decimal           @db.Decimal(12, 2)
  matchScore            Float
  netProfit             Decimal           @db.Decimal(12, 2)
  margin                Float
  roi                   Float
  recommendation        Recommendation
  notes                 String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ebayItemId]) // Prevent users from saving duplicates
  @@map("watchlist_items")
}

model Alert {
  id                    String            @id @default(uuid())
  userId                String
  title                 String
  query                 String
  targetProfit          Decimal           @db.Decimal(12, 2)
  targetMargin          Float
  isActive              Boolean           @default(true)
  emailNotifications    Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model SearchHistory {
  id                    String            @id @default(uuid())
  userId                String
  query                 String
  marketplace           String
  resultsCount          Int
  createdAt             DateTime          @default(now())

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_histories")
}